<div class="standard-form">
    {{!-- Navegação por Abas --}}
    <nav class="dh-config-nav">
        <button type="button" class="dh-config-tab-btn active" data-action="tab" data-target="features">
            <i class="fas fa-star"></i> Features
        </button>
        <button type="button" class="dh-config-tab-btn" data-action="tab" data-target="actors">
            <i class="fas fa-users"></i> Actors
        </button>
        <button type="button" class="dh-config-tab-btn" data-action="tab" data-target="general">
            <i class="fas fa-sliders-h"></i> General
        </button>
        <button type="button" class="dh-config-tab-btn" data-action="tab" data-target="icons">
            <i class="fas fa-image"></i> Icons
        </button>
    </nav>

    {{!-- Aba: Features --}}
    <div class="dh-config-tab-content active" data-tab="features">
        <p class="notes dh-config-notes"><strong>Item Compendiums:</strong> Searched for matching Features/Abilities.</p>
        <div class="form-group-stacked dh-config-list">
            {{#each featureCompendiums}}
            <label class="checkbox dh-config-item">
                <input type="checkbox" name="featureCompendiums" value="{{this.id}}" {{checked this.selected}}>
                <span>
                    {{this.title}}
                    <span class="dh-config-item-id">{{this.id}}</span>
                </span>
            </label>
            {{/each}}
        </div>
    </div>

    {{!-- Aba: Actors --}}
    <div class="dh-config-tab-content" data-tab="actors">
        <p class="notes dh-config-notes"><strong>Actor Compendiums:</strong> Searched for Potential Adversaries in Environments.</p>
        <div class="form-group-stacked dh-config-list">
            {{#each actorCompendiums}}
            <label class="checkbox dh-config-item">
                <input type="checkbox" name="actorCompendiums" value="{{this.id}}" {{checked this.selected}}>
                <span>
                    {{this.title}}
                    <span class="dh-config-item-id">{{this.id}}</span>
                </span>
            </label>
            {{/each}}
        </div>
    </div>

    {{!-- Aba: General --}}
    <div class="dh-config-tab-content" data-tab="general">
        <p class="notes dh-config-notes dh-config-notes--general"><strong>General Settings:</strong> Configure import behavior.</p>

        <div class="form-group">
            <label for="adversaryFolderName">Adversary Folder Name</label>
            <input type="text" name="adversaryFolderName" value="{{adversaryFolderName}}" placeholder="💀 Imported Adversaries">
        </div>

        <div class="form-group">
            <label for="environmentFolderName">Environment Folder Name</label>
            <input type="text" name="environmentFolderName" value="{{environmentFolderName}}" placeholder="🏰 Imported Environments">
        </div>

        <div class="form-group">
            <label for="lootFolderName">Loot Folder Name</label>
            <input type="text" name="lootFolderName" value="{{lootFolderName}}" placeholder="👑 Imported Loot">
        </div>

        <div class="form-group">
            <label for="consumableFolderName">Consumable Folder Name</label>
            <input type="text" name="consumableFolderName" value="{{consumableFolderName}}" placeholder="🧪 Imported Consumables">
        </div>

        <div class="form-group">
            <label for="weaponFolderName">Weapon Folder Name</label>
            <input type="text" name="weaponFolderName" value="{{weaponFolderName}}" placeholder="⚔️ Imported Weapons">
        </div>

        <div class="form-group">
            <label for="armorFolderName">Armor Folder Name</label>
            <input type="text" name="armorFolderName" value="{{armorFolderName}}" placeholder="🛡️ Imported Armors">
        </div>

        <div class="form-group">
            <label for="featureFolderName">Feature Folder Name</label>
            <input type="text" name="featureFolderName" value="{{featureFolderName}}" placeholder="✨ Imported Features">
        </div>

         <div class="form-group">
            <label for="domainCardFolderName">Domain Card Folder Name</label>
            <input type="text" name="domainCardFolderName" value="{{domainCardFolderName}}" placeholder="📜 Imported Domain Cards">
        </div>

        <hr class="dh-config-separator">

        <div class="form-group">
            <label for="separatorMode">Bulk Import Separator</label>
            <select name="separatorMode">
                <option value="blankLine" {{#if (eq separatorMode "blankLine")}}selected{{/if}}>Blank Line (default)</option>
                <option value="separator" {{#if (eq separatorMode "separator")}}selected{{/if}}>=== Separator</option>
            </select>
            <p class="hint dh-config-hint">How to separate multiple entries when importing in bulk.</p>
        </div>

        <div class="form-group">
            <label for="secretPrompts">GM Prompts as Secrets</label>
            <select name="secretPrompts">
                <option value="auto" {{#if (eq secretPrompts "auto")}}selected{{/if}}>Marker + environment questions (default)</option>
                <option value="marker" {{#if (eq secretPrompts "marker")}}selected{{/if}}>*Marker* only</option>
                <option value="off" {{#if (eq secretPrompts "off")}}selected{{/if}}>Off</option>
            </select>
            <p class="hint dh-config-hint">Text wrapped in *asterisks* becomes a secret block in the feature description. In environments, the questions that end a feature are also made secret when no marker is used. Off keeps everything as plain description text.</p>
        </div>
    </div>

    {{!-- Aba: Icons --}}
    <div class="dh-config-tab-content" data-tab="icons">
        <p class="notes dh-config-notes dh-config-notes--general"><strong>Feature Icons:</strong> Default icons used for features created during import, chosen by feature type.</p>

        {{#each featureIcons}}
        <div class="form-group">
            <label>{{label}}</label>
            <div class="dh-icon-picker-row">
                <img class="dh-icon-preview" data-target="featureIcons.{{form}}"
                     src="{{src}}" title="Current icon">
                <input type="text" name="featureIcons.{{form}}" value="{{src}}">
                <button type="button" class="dh-icon-picker-btn" data-target="featureIcons.{{form}}">
                    <i class="fas fa-file-image"></i>
                </button>
            </div>
        </div>
        {{/each}}

        <hr class="dh-config-separator">

        <div class="form-group">
            <label for="featureIconSource">Adversary/Environment Feature Icon</label>
            <select name="featureIconSource">
                <option value="type" {{#if (eq featureIconSource "type")}}selected{{/if}}>Icon by feature type</option>
                <option value="portrait" {{#if (eq featureIconSource "portrait")}}selected{{/if}}>Actor portrait</option>
            </select>
            <p class="hint dh-config-hint">Actor portrait replaces the type icons for features embedded in imported adversaries and environments. Standalone feature imports always use the type icons.</p>
        </div>

        <div class="form-group">
            <label class="checkbox" style="font-weight:normal; display:flex; align-items:center; gap:8px;">
                <input type="checkbox" name="featureIconOverrideCompendium" {{checked featureIconOverrideCompendium}}>
                <span>Apply to compendium features</span>
            </label>
            <p class="hint dh-config-hint">When enabled, features matched from a compendium also receive the icon above instead of their original artwork. The compendium itself is not changed.</p>
        </div>
    </div>

    <div class="form-footer">
        <button type="submit" class="save-button">
            <i class="fas fa-save"></i> Save Settings
        </button>
    </div>
</div>